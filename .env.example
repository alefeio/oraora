# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_DISPLAY_NAME=Ora por Mim

# Better Auth — gere um segredo local exclusivo (nunca reutilize de outros projetos)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Auth email (desenvolvimento)
AUTH_EMAIL_MODE=console
AUTH_EMAIL_LOG_PATH=tmp/auth-emails.log
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# PostgreSQL local isolado
# Caminho verificado na Sprint F: Prisma Postgres local (`npx prisma dev --name intercessao --detach`)
# Exemplo após `prisma dev ls` (portas mudam a cada start):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:<TCP_PORT>/intercessao_dev?sslmode=disable
DATABASE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:51218/intercessao_dev?sslmode=disable
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:51218/intercessao_dev?sslmode=disable
RUNTIME_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:51218/intercessao_dev?sslmode=disable

# Alternativa: Docker Compose (porta 55433) — requer Docker Desktop saudável
# DATABASE_URL=postgresql://intercessao:intercessao_dev_only@127.0.0.1:55433/intercessao_dev
# DIRECT_URL=postgresql://intercessao:intercessao_dev_only@127.0.0.1:55433/intercessao_dev
# RUNTIME_DATABASE_URL=postgresql://intercessao:intercessao_dev_only@127.0.0.1:55433/intercessao_dev

# Futuro Vercel / Prisma Postgres (não configurar agora)
# DATABASE_URL_POOLED=
# POSTGRES_URL=
# ALLOW_REMOTE_DB_WRITE=false
